<Window x:Class="VideoCall.Client.Views.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مكالمة واردة" Width="340" Height="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="CallerText" Style="{StaticResource TitleText}" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button Content="قبول" Style="{StaticResource PrimaryButton}" Click="Accept_Click" />
            <Button Content="رفض" Style="{StaticResource DangerButton}" Click="Reject_Click" />
        </StackPanel>
    </StackPanel>
</Window>
