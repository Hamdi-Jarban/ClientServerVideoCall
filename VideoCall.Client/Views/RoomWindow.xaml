<Window x:Class="VideoCall.Client.Views.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="غرفة المكالمة" Height="520" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="غرفة المكالمة" Style="{StaticResource TitleText}" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="رقم الغرفة" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource RoundedTextBox}"
                         Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasRoom, Converter={StaticResource InverseBooleanConverter}}" />
                <Button Grid.Column="1" Content="إنشاء غرفة" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding CreateRoomCommand}" IsEnabled="{Binding HasRoom, Converter={StaticResource InverseBooleanConverter}}" />
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" Margin="0,10,0,0" TextAlignment="Right" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="المضيف: " /><Run Text="{Binding Host, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,14"
                Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="المشاركون" Style="{StaticResource FieldLabel}" FontSize="15" Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding Members}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#334155" CornerRadius="8" Padding="10" Margin="0,4">
                                <TextBlock Text="{Binding}" TextAlignment="Right" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource RoundedTextBox}"
                     Text="{Binding NewMemberUsername, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="إضافة مستخدم" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    Command="{Binding AddUserCommand}" Click="Button_Click" />
            <Button Grid.Column="2" Content="مغادرة الغرفة" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                    Command="{Binding LeaveRoomCommand}" />
        </Grid>
    </Grid>
</Window>
